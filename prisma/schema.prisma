generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConsultStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Consult {
  id          String        @id @default(cuid())
  category    String
  description String
  status      ConsultStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}
